<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Target .NET 10 on Windows with WPF. If you only have the .NET 8 LTS SDK,
    change the TargetFramework to net8.0-windows - the code is compatible.
    WPF requires building ON Windows (the WPF build tasks are Windows-only).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MathAssistant</AssemblyName>
    <RootNamespace>MathAssistant</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local SQLite history store. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- MVVM helpers (RelayCommand, ObservableObject). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Windows DPAPI (ProtectedData) for encrypting API keys at rest. Listed
         explicitly so the build never depends on what the shared framework ships. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <!-- Ship the Python engine next to the app so it can be launched at runtime. -->
  <ItemGroup>
    <None Include="..\..\math-engine\**\*.py" LinkBase="math-engine\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\math-engine\requirements.txt" LinkBase="math-engine\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
