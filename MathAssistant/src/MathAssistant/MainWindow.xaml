<Window x:Class="MathAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MathAssistant.ViewModels"
        xmlns:views="clr-namespace:MathAssistant.Views"
        Title="AI Mathematics Assistant" Height="760" Width="1120"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <views:RoleToBrushConverter x:Key="RoleBrush"/>
        <views:RoleToAlignmentConverter x:Key="RoleAlign"/>
        <views:StringToVisibilityConverter x:Key="StrVis"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.4*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Left: chat ===== -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="4,0,4,8">
                <TextBlock Text="AI Mathematics Assistant" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <Button Content="Settings" Command="{Binding OpenSettingsCommand}"
                        DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                <CheckBox Content="Practice mode" IsChecked="{Binding PracticeMode}"
                          DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                          Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>

            <!-- Transcript -->
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Role, Converter={StaticResource RoleBrush}}"
                                        HorizontalAlignment="{Binding Role, Converter={StaticResource RoleAlign}}"
                                        CornerRadius="10" Padding="12,8" Margin="4" MaxWidth="640">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImagePath}" FontStyle="Italic"
                                                   Foreground="{StaticResource AccentBrush}" FontSize="11"
                                                   Visibility="{Binding ImagePath, Converter={StaticResource StrVis}}"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <Button Content="Copy" HorizontalAlignment="Right" Margin="0,6,0,0"
                                                Padding="8,2" FontSize="10" Background="#33000000"
                                                Command="{Binding DataContext.CopyMessageCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Attachment + status -->
            <DockPanel Grid.Row="2" Margin="4,8,4,4">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right"
                            Visibility="{Binding AttachmentName, Converter={StaticResource StrVis}}">
                    <TextBlock Text="📎 " Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AttachmentName}" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" Command="{Binding ClearAttachmentCmdCommand}" Padding="6,2" Margin="6,0,0,0"
                            Background="#44000000"/>
                </StackPanel>
            </DockPanel>

            <!-- Input row -->
            <Grid Grid.Row="3" Margin="4,4,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Attach" Command="{Binding AttachImageCommand}"
                        Background="{StaticResource PanelBrush}"/>
                <Button Grid.Column="1" Content="Paste" Command="{Binding PasteImageCommand}"
                        Background="{StaticResource PanelBrush}"/>
                <TextBox Grid.Column="2" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                         BorderThickness="0" Padding="10,8" Margin="4,0" VerticalContentAlignment="Center"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                         FontSize="14">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding SendCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="3" Content="Send ▶" Command="{Binding SendCommand}" MinWidth="90"/>
            </Grid>
        </Grid>

        <!-- ===== Right: history ===== -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="History" FontWeight="SemiBold" FontSize="15"
                           Foreground="{StaticResource TextBrush}" Margin="4,4,4,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Stretch" Background="{StaticResource AssistantBubble}"
                                        Margin="2,3" Padding="8,6"
                                        Command="{Binding DataContext.LoadHistoryEntryCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Question}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding Topic}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="2,8,2,2">
                    <Button Content="Export" Command="{Binding ExportHistoryCommand}"
                            Background="{StaticResource PanelBrush}" MinWidth="80"/>
                    <Button Content="Clear history" Command="{Binding ClearHistoryCommand}"
                            Background="#44000000" MinWidth="110"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Busy overlay -->
        <Border Grid.ColumnSpan="2" Background="#99000000" CornerRadius="10"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Thinking…" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="220" Height="6" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
