# ---------------------------------------------------------------------------
# Nearabouts configuration. Copy this file to ".env" and fill in what you need.
# NEVER commit your real .env file (it is already in .gitignore).
# ---------------------------------------------------------------------------

# Port the web server listens on (hosting providers usually set this for you).
PORT=8787

# Where the SQLite database file lives. On a host, point this at a persistent disk,
# e.g. /data/nearabouts.sqlite, or your data is lost on every redeploy.
DATABASE_PATH=data/nearabouts.sqlite

# Public address of your site (used only for share links). Optional.
PUBLIC_URL=

# --- Street-level imagery -------------------------------------------------
# "demo"      = illustrated scenes drawn by Nearabouts (no account needed, not photos)
# "mapillary" = real community photos from Mapillary (free account + client token)
IMAGERY_PROVIDER=demo
# From https://www.mapillary.com/dashboard/developers -> "Register application".
# This token is sent to browsers (MapillaryJS needs it), so it is public by design.
MAPILLARY_CLIENT_TOKEN=
# Max imagery lookups per day (protects you from runaway usage).
PROVIDER_DAILY_BUDGET=2000

# --- Guess map street tiles (optional) -----------------------------------
# Leave empty to use the built-in country-border map only.
# OpenStreetMap's tile servers allow light use with attribution; for a busy site use a
# tile provider with its own key (e.g. MapTiler, Stadia Maps) and follow their terms.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
# Example:
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# --- Security / hosting ----------------------------------------------------
# Comma-separated usernames that get admin rights (can remove community maps).
ADMIN_USERNAMES=
# Set to true when running behind a proxy/load balancer (Render, Fly.io, Railway...).
TRUST_PROXY=false
# Secure cookies are on automatically when NODE_ENV=production (requires HTTPS).
# COOKIE_SECURE=true
